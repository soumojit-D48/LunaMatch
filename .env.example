# LunaMatch — copy to .env and fill in locally. Never commit .env.
# See docs/PROJECT_STRUCTURE.md and docs/TECH_STACK.md.

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg://lunamatch:lunamatch@localhost:5432/lunamatch
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO, S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=lunamatch
MINIO_SECURE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- ML ---
# cuda | cpu (worker auto-falls back to CPU classical pipeline if no GPU)
MODEL_DEVICE=cpu

# --- Storage paths (local dev) ---
DATA_DIR=./data
MODELS_DIR=./backend/models
